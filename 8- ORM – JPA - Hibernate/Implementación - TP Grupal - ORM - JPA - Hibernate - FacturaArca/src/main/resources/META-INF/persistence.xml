<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Listado explícito de tus entidades para que Hibernate las cree -->
        <class>com.facturaarca.entities.Articulo</class>
        <class>com.facturaarca.entities.Contacto</class>
        <class>com.facturaarca.entities.Domicilio</class>
        <class>com.facturaarca.entities.EntityId</class>
        <class>com.facturaarca.entities.FacturaVenta</class>
        <class>com.facturaarca.entities.FacturaVentaDetalle</class>
        <class>com.facturaarca.entities.ListaPrecio</class>
        <class>com.facturaarca.entities.ListaPrecioArticulo</class>
        <class>com.facturaarca.entities.Marca</class>
        <class>com.facturaarca.entities.PuntoVenta</class>
        <class>com.facturaarca.entities.Rubro</class>
        <class>com.facturaarca.entities.TipoMoneda</class>
        <class>com.facturaarca.entities.Usuario</class>
        <class>com.facturaarca.entities.Cliente</class>
        <class>com.facturaarca.entities.CondicionIva</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/factura_arca"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="milanesa123"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>